# Every value here is optional: with an empty .env the app runs in guest mode
# and still has working AI, because Puter.js needs no API key.

# Optional Cloud accounts + sync (Supabase). Client-side values — they are embedded in the build.
# Create a project at https://supabase.com, then copy the Project URL and the anon public key.
# Run supabase/schema.sql in the SQL editor first (it creates the tables and the RLS policies).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: port for `npm run preview` (serving the built app).
PORT=3001

# Optional Puter.js overrides. Leave blank to use Puter's own defaults.
# VITE_PUTER_MODEL=      # e.g. gpt-4o-mini, claude-sonnet-4, gemini-2.0-flash
# VITE_PUTER_TTS_VOICE=  # e.g. Joanna, alloy, Kore
